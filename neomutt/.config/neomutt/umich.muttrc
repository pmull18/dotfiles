# --- University Identity ---
set realname = "Patrick Mullen"
set from = "pgmullen@umich.edu"
set use_from = yes
set envelope_from = yes

# --- University IMAP ---
set folder = "imaps://imap.gmail.com:993"
set spoolfile = "+INBOX"
set postponed = "+[Gmail]/Drafts"
set record = "+[Gmail]/Sent Mail"
set trash = "+[Gmail]/Trash"

set imap_user = "pgmullen@umich.edu"
set imap_pass = "`security find-generic-password -w -s mutt-uni-imap -a your.netid@university.edu`"

# --- University SMTP ---
set smtp_url = "smtps://pgmullen@umich.edu@smtp.gmail.com:465"
set smtp_pass = "`security find-generic-password -w -s mutt-uni-imap -a pgmullen@umich.edu`"

